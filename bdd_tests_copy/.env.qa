# QA Environment Configuration
ENVIRONMENT=qa

# API Configuration
API_BASE_URL=https://qa-api.example.com
API_TIMEOUT=45
API_RETRY_COUNT=3

# Database Configuration
DB_HOST=qa-db.example.com
DB_PORT=1521
DB_USER=qa_user
DB_PRD=qa_password_secure_123
DB_SERVICE_NAME=QA_SERVICE
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Certificate Configuration
CERT_PFX_PATH=certs/qa/certificate.pfx
CERT_PRD=qa_cert_password_456

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/qa_automation.log
ENABLE_DETAILED_LOGGING=true
ENABLE_DB_QUERY_LOGGING=false
VERIFY_SSL=true
